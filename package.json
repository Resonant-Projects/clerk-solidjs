{
  "name": "clerk-solidjs",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "clean-install": "rimraf pnpm-lock.yaml --glob **/node_modules && pnpm install",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "e2e:list": "playwright test --list",
    "e2e:typecheck": "pnpm --filter clerk-solidjs-basic-example exec tsc -p ../../tsconfig.e2e.json --noEmit",
    "e2e": "playwright test",
    "format:check": "turbo format:check",
    "format": "turbo format",
    "lint:fix": "turbo lint:fix",
    "lint": "turbo lint",
    "prepare": "husky",
    "prerelease": "turbo clean && turbo type-check && turbo format:check && turbo lint && turbo test",
    "release": "turbo clean && turbo build && changeset publish",
    "test:watch": "turbo test:watch",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "version": "changeset version && pnpm install --no-frozen-lockfile && pnpm run format",
    "smoke": "node scripts/smoke-example.mjs",
    "check-file-tokens": "node scripts/check-file-tokens.mjs"
  },
  "author": "Resonant Projects",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@clerk/backend": "^3.26.2",
    "@clerk/testing": "^2.2.50",
    "@playwright/test": "^1.64.1",
    "husky": "^9.1.7",
    "pkg-pr-new": "0.0.92",
    "playwright": "1.64.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}

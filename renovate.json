{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "baseBranchPatterns": ["master"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "automerge": false,
    "labels": ["security"],
    "minimumReleaseAge": "3 days"
  },
  "osvVulnerabilityAlerts": true,
  "github-actions": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Batch minor updates into one weekly PR for manual review. Listed first so the Clerk and Solid groups below keep their own PRs",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor updates",
      "groupSlug": "minor",
      "automerge": false
    },
    {
      "description": "Clerk SDK packages move together; review every bump for Solid porting work",
      "matchPackageNames": ["@clerk/**"],
      "groupName": "clerk",
      "groupSlug": "clerk",
      "automerge": false,
      "labels": ["clerk-sync"],
      "prBodyNotes": [
        "Check @clerk/react changes for new or changed exports that need Solid ports before merging."
      ]
    },
    {
      "description": "Clerk patches open as soon as they are 3 days old, outside the weekly window; they are still reviewed by hand",
      "matchPackageNames": ["@clerk/**"],
      "matchUpdateTypes": ["patch"],
      "groupName": "clerk patches",
      "groupSlug": "clerk-patch",
      "schedule": ["at any time"]
    },
    {
      "description": "Clerk majors require dashboard approval",
      "matchPackageNames": ["@clerk/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Solid ecosystem packages move together",
      "matchPackageNames": [
        "solid-js",
        "@solidjs/**",
        "vite-plugin-solid",
        "eslint-plugin-solid",
        "tsup-preset-solid",
        "@solid-primitives/**"
      ],
      "groupName": "solid ecosystem",
      "groupSlug": "solid"
    },
    {
      "description": "Automerge non-Clerk dev tooling patch updates only. platformAutomerge is off, so Renovate merges itself once every check, including the required ci-required, has passed",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": ["!@clerk/**"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Never automerge 0.x packages: SemVer lets them break in any release. Matches the locked version",
      "matchCurrentVersion": "/^0\\./",
      "automerge": false
    },
    {
      "description": "All majors require dashboard approval",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Peer dependency ranges are a public contract; widen them manually",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}

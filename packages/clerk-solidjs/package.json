{
  "name": "@resonant-projects/clerk-solidjs",
  "description": "Clerk SDK for SolidJS and SolidStart",
  "private": false,
  "version": "3.2.0",
  "keywords": [
    "solidjs",
    "clerk",
    "solid",
    "clerk-auth"
  ],
  "bugs": {
    "url": "https://github.com/Resonant-Projects/clerk-solidjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resonant-Projects/clerk-solidjs.git",
    "directory": "packages/clerk-solidjs"
  },
  "license": "MIT",
  "author": "Resonant Projects",
  "type": "module",
  "main": "./dist/index/server.cjs",
  "module": "./dist/index/server.js",
  "types": "./dist/index/index.d.ts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "errors": [
        "./dist/errors/index.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ],
      "start": [
        "./dist/start/index.d.ts"
      ],
      "start/server": [
        "./dist/start/server/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "worker": {
        "solid": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/server.jsx"
        },
        "import": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/server.js"
        },
        "require": {
          "types": "./dist/index/index.d.cts",
          "default": "./dist/index/server.cjs"
        }
      },
      "browser": {
        "solid": {
          "types": "./dist/index/index.d.ts",
          "development": "./dist/index/dev.jsx",
          "default": "./dist/index/index.jsx"
        },
        "development": {
          "import": {
            "types": "./dist/index/index.d.ts",
            "default": "./dist/index/dev.js"
          },
          "require": {
            "types": "./dist/index/index.d.cts",
            "default": "./dist/index/dev.cjs"
          }
        },
        "import": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/index.js"
        },
        "require": {
          "types": "./dist/index/index.d.cts",
          "default": "./dist/index/index.cjs"
        }
      },
      "deno": {
        "solid": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/server.jsx"
        },
        "import": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/server.js"
        },
        "require": {
          "types": "./dist/index/index.d.cts",
          "default": "./dist/index/server.cjs"
        }
      },
      "node": {
        "solid": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/server.jsx"
        },
        "import": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/server.js"
        },
        "require": {
          "types": "./dist/index/index.d.cts",
          "default": "./dist/index/server.cjs"
        }
      },
      "solid": {
        "types": "./dist/index/index.d.ts",
        "development": "./dist/index/dev.jsx",
        "default": "./dist/index/index.jsx"
      },
      "development": {
        "import": {
          "types": "./dist/index/index.d.ts",
          "default": "./dist/index/dev.js"
        },
        "require": {
          "types": "./dist/index/index.d.cts",
          "default": "./dist/index/dev.cjs"
        }
      },
      "import": {
        "types": "./dist/index/index.d.ts",
        "default": "./dist/index/index.js"
      },
      "require": {
        "types": "./dist/index/index.d.cts",
        "default": "./dist/index/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      },
      "require": {
        "types": "./dist/errors/index.d.cts",
        "default": "./dist/errors/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./start": {
      "worker": {
        "solid": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/server.jsx"
        },
        "import": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/server.js"
        },
        "require": {
          "types": "./dist/start/index.d.cts",
          "default": "./dist/start/server.cjs"
        }
      },
      "browser": {
        "solid": {
          "types": "./dist/start/index.d.ts",
          "development": "./dist/start/dev.jsx",
          "default": "./dist/start/index.jsx"
        },
        "development": {
          "import": {
            "types": "./dist/start/index.d.ts",
            "default": "./dist/start/dev.js"
          },
          "require": {
            "types": "./dist/start/index.d.cts",
            "default": "./dist/start/dev.cjs"
          }
        },
        "import": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/index.js"
        },
        "require": {
          "types": "./dist/start/index.d.cts",
          "default": "./dist/start/index.cjs"
        }
      },
      "deno": {
        "solid": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/server.jsx"
        },
        "import": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/server.js"
        },
        "require": {
          "types": "./dist/start/index.d.cts",
          "default": "./dist/start/server.cjs"
        }
      },
      "node": {
        "solid": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/server.jsx"
        },
        "import": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/server.js"
        },
        "require": {
          "types": "./dist/start/index.d.cts",
          "default": "./dist/start/server.cjs"
        }
      },
      "solid": {
        "types": "./dist/start/index.d.ts",
        "development": "./dist/start/dev.jsx",
        "default": "./dist/start/index.jsx"
      },
      "development": {
        "import": {
          "types": "./dist/start/index.d.ts",
          "default": "./dist/start/dev.js"
        },
        "require": {
          "types": "./dist/start/index.d.cts",
          "default": "./dist/start/dev.cjs"
        }
      },
      "import": {
        "types": "./dist/start/index.d.ts",
        "default": "./dist/start/index.js"
      },
      "require": {
        "types": "./dist/start/index.d.cts",
        "default": "./dist/start/index.cjs"
      }
    },
    "./start/server": {
      "import": {
        "types": "./dist/start/server/index.d.ts",
        "default": "./dist/start/server/index.js"
      },
      "require": {
        "types": "./dist/start/server/index.d.cts",
        "default": "./dist/start/server/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "./dist/index/server.js": "./dist/index/index.js",
    "./dist/index/server.cjs": "./dist/index/index.cjs",
    "./dist/start/server.js": "./dist/start/index.js",
    "./dist/start/server.cjs": "./dist/start/index.cjs"
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch .",
    "dev:publish": "pnpm run dev -- --env.publish",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rimraf dist",
    "publish:local": "pnpm dlx yalc push --replace  --sig",
    "check:dist": "node scripts/check-dist.mjs",
    "vendor:clerk-ui-types": "node scripts/vendor-clerk-ui-types.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.24.0",
    "@clerk/shared": "^4.40.0",
    "@solid-primitives/context": "^0.3.2",
    "@solid-primitives/destructure": "^0.2.4",
    "@solid-primitives/jsx-tokenizer": "^1.1.4",
    "@tanstack/query-core": "^5.104.3",
    "csstype": "^3.1.3"
  },
  "devDependencies": {
    "@clerk/clerk-js": "^6.39.1",
    "@clerk/localizations": "^4.23.0",
    "@clerk/ui": "^1.40.2",
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "expect-type": "^1.4.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@solidjs/router": ">=0.14",
    "@solidjs/start": ">=1",
    "solid-js": ">=1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/Resonant-Projects/clerk-solidjs#readme",
  "contributors": [
    "Ian Pascoe (original author)"
  ]
}
